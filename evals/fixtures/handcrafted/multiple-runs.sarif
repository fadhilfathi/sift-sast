{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": { "driver": { "name": "scanner-alpha", "version": "1.0.0" } },
      "automationDetails": { "id": "alpha/python/" },
      "results": [
        {
          "ruleId": "alpha.sql.injection",
          "level": "error",
          "message": { "text": "First run, first finding." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/db.py" },
                "region": { "startLine": 20 }
              }
            }
          ]
        }
      ]
    },
    {
      "tool": { "driver": { "name": "scanner-beta", "version": "2.0.0" } },
      "automationDetails": { "id": "beta/javascript/" },
      "results": [
        {
          "ruleId": "beta.xss",
          "level": "warning",
          "message": { "text": "Second run, different tool, different language." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "web/render.js" },
                "region": { "startLine": 3 }
              }
            }
          ]
        },
        {
          "ruleId": "alpha.sql.injection",
          "level": "error",
          "message": { "text": "Same ruleId and same location as run one. A different run makes it a distinct finding, and dedupe must not merge across runs." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/db.py" },
                "region": { "startLine": 20 }
              }
            }
          ]
        }
      ]
    },
    {
      "tool": { "driver": { "name": "scanner-gamma", "version": "3.0.0" } },
      "results": [],
      "invocations": [{ "executionSuccessful": false, "exitCode": 1 }]
    }
  ]
}
