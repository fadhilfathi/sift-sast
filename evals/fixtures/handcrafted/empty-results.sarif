{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": { "driver": { "name": "handcrafted", "version": "0.0.0", "rules": [] } },
      "results": []
    },
    {
      "tool": { "driver": { "name": "handcrafted-no-results-key", "version": "0.0.0" } }
    },
    {
      "tool": { "driver": { "name": "handcrafted-no-rules-key", "version": "0.0.0" } },
      "results": [
        {
          "ruleId": "rule.without.rules.array",
          "message": { "text": "The driver declares no rules array at all." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/app.py" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
