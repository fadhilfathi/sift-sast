* text=auto eol=lf

# Never let a Windows checkout hand CRLF to a Linux runner.
Makefile text eol=lf
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# SARIF fixtures are compared as parsed documents in round-trip tests, and their
# bytes are recorded in MANIFEST.json. Git must not rewrite their line endings.
evals/fixtures/**/*.sarif -text
evals/fixtures/MANIFEST.json -text
evals/dataset/** -text
evals/fixtures/generate.sh text eol=lf
